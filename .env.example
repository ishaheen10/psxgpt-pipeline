# psxgpt-pipeline environment — copy to `.env` and fill in.
# `.env` is gitignored. Only fill the keys for the stages you run (see PIPELINE_SPEC.md).

# ── Parse (Gemini Flash Lite) — step 02_parse, 19_reparse_broken ──
GEMINI_API_KEY=
GEMINI_PARSE_MODEL=gemini-3.1-flash-lite

# ── Review + Extract (DeepSeek V4 Pro, OpenAI-compatible) — steps 04_tag, 08_extract ──
DEEPSEEK_API_KEY=
DEEPSEEK_API_BASE=https://api.deepseek.com
DEEPSEEK_REVIEW_MODEL=deepseek-v4-pro
DEEPSEEK_EXTRACT_MODEL=deepseek-v4-pro

# ── Cloudflare D1 (statement/ratio/document publish via wrangler) ──
# steps 13_d1_push, 15_ratios, 17_publish_documents, backfill_documents.py
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_D1_DATABASE_ID=

# ── Cloudflare R2 source assets (page PDFs + thumbnails) — r2_upload.py ──
# IMPORTANT: these are an R2 *S3 API token's* credentials (R2 → Manage R2 API Tokens →
# "Object Read & Write"), NOT a `cfat_`/`cfut_` Cloudflare API-token value. The S3 endpoint
# has no per-5-min rate limit; the Cloudflare REST API does (~1,200/5min) and will stall a
# bulk upload AND starve concurrent D1 wrangler pushes. r2_upload.py uses these via boto3.
CLOUDFLARE_R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
CLOUDFLARE_R2_BUCKET_NAME=psx
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=

# ── logging ──
LOG_LEVEL=INFO
