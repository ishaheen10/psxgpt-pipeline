# Read-only corpus API (D1 FTS5 + R2). Shared with apps/corpus-browser.
CORPUS_API_URL=https://psxgpt-corpus-api.isfandiyar-shaheen.workers.dev

# Compile providers. At least one key must be set for /api/compile to work.
# These are the same keys the pipeline already uses; see the repo root .env.
DEEPSEEK_API_KEY=
DEEPSEEK_API_BASE=https://api.deepseek.com
DEEPSEEK_COMPILE_MODEL=deepseek-v4-pro

GEMINI_API_KEY=
GEMINI_COMPILE_MODEL=gemini-3.1-flash-lite

MISTRAL_API_KEY=
MISTRAL_COMPILE_MODEL=mistral-large-latest
